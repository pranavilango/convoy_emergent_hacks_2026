# Copy to .env.local and fill in. See README → "Google Maps setup".
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=
NEXT_PUBLIC_GOOGLE_MAPS_MAP_ID=
GEMINI_API_KEY=
# Optional; defaults to gemini-3.5-flash-lite
GEMINI_MODEL=
# Optional. Leave unset to run the Rust allocator built into the app (works on Vercel).
# Set it only to use a separately running medroute HTTP service (`npm run dev:engine`, API.md).
# MEDROUTE_API_URL=http://127.0.0.1:8080
