# Copy to .env.local and fill in. See README → "Google Maps setup".
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=
NEXT_PUBLIC_GOOGLE_MAPS_MAP_ID=
GEMINI_API_KEY=
# Optional; defaults to gemini-3.5-flash-lite
GEMINI_MODEL=
# Rust medroute service (API.md); defaults to the local service.
MEDROUTE_API_URL=http://127.0.0.1:8080
